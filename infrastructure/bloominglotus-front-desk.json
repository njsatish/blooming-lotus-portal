"AWSTemplateFormatVersion: '2010-09-09'\nDescription: Secure Blooming Lotus front-desk appointment dashboard\nParameters:\n  AppointmentTableName: {Type: String}\n  DomainName: {Type: String}\n  FrontDeskEmail: {Type: String}\nResources:\n  FrontDeskUserPool:\n    Type: AWS::Cognito::UserPool\n    Properties:\n      UserPoolName: bloominglotus-front-desk\n      UsernameAttributes: [email]\n      AutoVerifiedAttributes: [email]\n      AdminCreateUserConfig: {AllowAdminCreateUserOnly: true}\n      Policies:\n        PasswordPolicy:\n          MinimumLength: 12\n          RequireLowercase: true\n          RequireUppercase: true\n          RequireNumbers: true\n          RequireSymbols: true\n          TemporaryPasswordValidityDays: 7\n      AccountRecoverySetting:\n        RecoveryMechanisms:\n          - {Name: verified_email, Priority: 1}\n  FrontDeskGroup:\n    Type: AWS::Cognito::UserPoolGroup\n    Properties:\n      GroupName: FrontDesk\n      Description: Blooming Lotus authorized front-desk staff\n      UserPoolId: !Ref FrontDeskUserPool\n  FrontDeskUser:\n    Type: AWS::Cognito::UserPoolUser\n    Properties:\n      UserPoolId: !Ref FrontDeskUserPool\n      Username: !Ref FrontDeskEmail\n      DesiredDeliveryMediums: [EMAIL]\n      UserAttributes:\n        - {Name: email, Value: !Ref FrontDeskEmail}\n        - {Name: email_verified, Value: 'true'}\n  FrontDeskMembership:\n    Type: AWS::Cognito::UserPoolUserToGroupAttachment\n    DependsOn: [FrontDeskGroup, FrontDeskUser]\n    Properties:\n      GroupName: FrontDesk\n      Username: !Ref FrontDeskEmail\n      UserPoolId: !Ref FrontDeskUserPool\n  FrontDeskClient:\n    Type: AWS::Cognito::UserPoolClient\n    Properties:\n      ClientName: bloominglotus-front-desk-web\n      UserPoolId: !Ref FrontDeskUserPool\n      GenerateSecret: false\n      AllowedOAuthFlowsUserPoolClient: true\n      AllowedOAuthFlows: [code]\n      AllowedOAuthScopes: [openid, email]\n      CallbackURLs: [!Sub 'https://${DomainName}/admin/index.html']\n      LogoutURLs: [!Sub 'https://${DomainName}/']\n      SupportedIdentityProviders: [COGNITO]\n      PreventUserExistenceErrors: ENABLED\n      EnableTokenRevocation: true\n      AccessTokenValidity: 60\n      IdTokenValidity: 60\n      RefreshTokenValidity: 1\n      TokenValidityUnits: {AccessToken: minutes, IdToken: minutes, RefreshToken: days}\n  FrontDeskDomain:\n    Type: AWS::Cognito::UserPoolDomain\n    Properties:\n      Domain: !Sub 'bloominglotus-frontdesk-${AWS::AccountId}'\n      UserPoolId: !Ref FrontDeskUserPool\n  AdminRole:\n    Type: AWS::IAM::Role\n    Properties:\n      AssumeRolePolicyDocument:\n        Version: '2012-10-17'\n        Statement: [{Effect: Allow, Principal: {Service: lambda.amazonaws.com}, Action: 'sts:AssumeRole'}]\n      ManagedPolicyArns: [arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole]\n      Policies:\n        - PolicyName: AppointmentAdministration\n          PolicyDocument:\n            Version: '2012-10-17'\n            Statement:\n              - Effect: Allow\n                Action: [dynamodb:Scan, dynamodb:GetItem, dynamodb:UpdateItem]\n                Resource: !Sub 'arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${AppointmentTableName}'\n  AdminFunction:\n    Type: AWS::Lambda::Function\n    Properties:\n      Runtime: python3.13\n      Handler: index.handler\n      Role: !GetAtt AdminRole.Arn\n      Timeout: 15\n      MemorySize: 256\n      Environment: {Variables: {TABLE_NAME: !Ref AppointmentTableName}}\n      Code:\n        ZipFile: |\n          import json, os, boto3\n          from datetime import datetime, timezone\n          from decimal import Decimal\n          ddb=boto3.resource('dynamodb').Table(os.environ['TABLE_NAME'])\n          STATUSES={'REQUESTED','CONTACTED','CONFIRMED','RESCHEDULE_NEEDED','CANCELLED','COMPLETED','NO_SHOW'}\n          def enc(v):\n            if isinstance(v,Decimal): return int(v) if v%1==0 else float(v)\n            raise TypeError\n          def reply(code,body): return {'statusCode':code,'headers':{'content-type':'application/json'},'body':json.dumps(body,default=enc)}\n          def handler(event,context):\n            claims=event.get('requestContext',{}).get('authorizer',{}).get('jwt',{}).get('claims',{})\n            groups=str(claims.get('cognito:groups','')).replace('[','').replace(']','').split()\n            if 'FrontDesk' not in ' '.join(groups): return reply(403,{'message':'Front-desk access required'})\n            method=event.get('requestContext',{}).get('http',{}).get('method','GET')\n            path=event.get('rawPath','')\n            if method=='GET' and path.endswith('/appointments'):\n              data=ddb.scan(Limit=200)\n              items=sorted(data.get('Items',[]),key=lambda x:x.get('createdAt',''),reverse=True)\n              return reply(200,{'appointments':items})\n            aid=(event.get('pathParameters') or {}).get('appointmentId')\n            if method=='GET' and aid:\n              item=ddb.get_item(Key={'appointmentId':aid}).get('Item')\n              return reply(200,{'appointment':item}) if item else reply(404,{'message':'Appointment not found'})\n            if method=='PATCH' and aid:\n              body=json.loads(event.get('body') or '{}'); status=body.get('status'); notes=str(body.get('frontDeskNotes','')).strip()\n              if status not in STATUSES: return reply(400,{'message':'Invalid status'})\n              if len(notes)>2000: return reply(400,{'message':'Notes are too long'})\n              now=datetime.now(timezone.utc).isoformat()\n              result=ddb.update_item(Key={'appointmentId':aid},UpdateExpression='SET #s=:s, frontDeskNotes=:n, updatedAt=:u, updatedBy=:b',ExpressionAttributeNames={'#s':'status'},ExpressionAttributeValues={':s':status,':n':notes,':u':now,':b':claims.get('sub','unknown')},ConditionExpression='attribute_exists(appointmentId)',ReturnValues='ALL_NEW')\n              return reply(200,{'appointment':result['Attributes']})\n            return reply(404,{'message':'Route not found'})\n  AdminApi:\n    Type: AWS::ApiGatewayV2::Api\n    Properties:\n      Name: bloominglotus-front-desk\n      ProtocolType: HTTP\n      CorsConfiguration:\n        AllowOrigins: [!Sub 'https://${DomainName}']\n        AllowMethods: [GET, PATCH, OPTIONS]\n        AllowHeaders: [authorization, content-type]\n  Integration:\n    Type: AWS::ApiGatewayV2::Integration\n    Properties: {ApiId: !Ref AdminApi, IntegrationType: AWS_PROXY, IntegrationMethod: POST, IntegrationUri: !GetAtt AdminFunction.Arn, PayloadFormatVersion: '2.0'}\n  Authorizer:\n    Type: AWS::ApiGatewayV2::Authorizer\n    Properties:\n      ApiId: !Ref AdminApi\n      AuthorizerType: JWT\n      IdentitySource: ['$request.header.Authorization']\n      Name: CognitoFrontDesk\n      JwtConfiguration:\n        Audience: [!Ref FrontDeskClient]\n        Issuer: !Sub 'https://cognito-idp.${AWS::Region}.amazonaws.com/${FrontDeskUserPool}'\n  ListRoute:\n    Type: AWS::ApiGatewayV2::Route\n    Properties: {ApiId: !Ref AdminApi, RouteKey: 'GET /admin/appointments', Target: !Join ['/', [integrations, !Ref Integration]], AuthorizationType: JWT, AuthorizerId: !Ref Authorizer}\n  GetRoute:\n    Type: AWS::ApiGatewayV2::Route\n    Properties: {ApiId: !Ref AdminApi, RouteKey: 'GET /admin/appointments/{appointmentId}', Target: !Join ['/', [integrations, !Ref Integration]], AuthorizationType: JWT, AuthorizerId: !Ref Authorizer}\n  PatchRoute:\n    Type: AWS::ApiGatewayV2::Route\n    Properties: {ApiId: !Ref AdminApi, RouteKey: 'PATCH /admin/appointments/{appointmentId}', Target: !Join ['/', [integrations, !Ref Integration]], AuthorizationType: JWT, AuthorizerId: !Ref Authorizer}\n  Stage:\n    Type: AWS::ApiGatewayV2::Stage\n    Properties: {ApiId: !Ref AdminApi, StageName: '$default', AutoDeploy: true, DefaultRouteSettings: {ThrottlingBurstLimit: 20, ThrottlingRateLimit: 10}}\n  Permission:\n    Type: AWS::Lambda::Permission\n    Properties: {Action: lambda:InvokeFunction, FunctionName: !Ref AdminFunction, Principal: apigateway.amazonaws.com, SourceArn: !Sub 'arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${AdminApi}/*/*'}\nOutputs:\n  ApiUrl: {Value: !GetAtt AdminApi.ApiEndpoint}\n  UserPoolId: {Value: !Ref FrontDeskUserPool}\n  ClientId: {Value: !Ref FrontDeskClient}\n  CognitoDomain: {Value: !Sub 'https://${FrontDeskDomain}.auth.${AWS::Region}.amazoncognito.com'}\n"
